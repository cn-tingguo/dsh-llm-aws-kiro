{
  "name": "dsh-llm-kiro-local",
  "version": "0.2.1-local.1",
  "description": "Kiro (AWS CodeWhisperer/Q successor) provider for the DeepSeek Harness: ambient credential pickup, OAuth token refresh, and the Kiro runtime/management API",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "client/index.js"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": ">=0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dependencies": {
    "@smithy/core": "^3.24.0",
    "@smithy/types": "^4.14.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.5",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8",
    "@deepseek-ai/schemastery": "3.18.5"
  }
}